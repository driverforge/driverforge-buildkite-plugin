#!/bin/bash
# Always install the Driverforge CLI onto PATH, regardless of mode. Sourced by the
# agent, so the exported PATH persists into the command phase (and the step's own
# command). The `command` hook then either runs a configured target or the step's
# own command.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=lib/driverforge-install.bash disable=SC1091
source "${DIR}/lib/driverforge-install.bash"

driverforge_install
